{
  "type": "header",
  "name": "t:names.header",
  "sections": {
    "header_announcements": {
      "type": "header-announcements",
      "blocks": {
        "announcement_merch": {
          "type": "_announcement",
          "settings": {
            "text": "Nieuw: de officiële merch van Bouillon d’Amsterdam. Bestel online of haal af in het restaurant.",
            "link": "shopify://collections/all",
            "font": "var(--font-body--family)",
            "font_size": "0.875rem",
            "weight": "400",
            "letter_spacing": "normal",
            "case": "none",
            "text_color": "#ffffff"
          },
          "blocks": {}
        }
      },
      "block_order": [
        "announcement_merch"
      ],
      "name": "t:names.announcement_bar",
      "settings": {
        "speed": 5,
        "section_width": "full-width",
        "background_color": "{{ settings.color_palette.color1 }}",
        "divider_width": 0,
        "divider_color": "{{ settings.color_palette.color1 }}",
        "padding-block-start": 12,
        "padding-block-end": 12
      }
    },
    "header_section": {
      "type": "header",
      "blocks": {
        "header-logo": {
          "type": "_header-logo",
          "static": true,
          "settings": {
            "hide_logo_on_home_page": false,
            "padding-block-start": 0,
            "padding-block-end": 0
          },
          "blocks": {}
        },
        "header-menu": {
          "type": "_header-menu",
          "static": true,
          "settings": {
            "menu": "main-menu",
            "background_color": "{{ settings.color_palette.background }}",
            "text_color": "{{ settings.color_palette.foreground }}",
            "type_font_primary_size": "1rem",
            "menu_font_style": "regular",
            "type_font_primary_link": "body",
            "type_case_primary_link": "none",
            "menu_style": "text",
            "featured_products_aspect_ratio": "4 / 5",
            "featured_collections_aspect_ratio": "16 / 9",
            "image_border_radius": 0,
            "navigation_bar": false,
            "background_color_navigation_bar": "{{ settings.color_palette.background }}",
            "text_color_navigation_bar": "{{ settings.color_palette.foreground }}",
            "drawer_accordion": false,
            "drawer_accordion_expand_first": false,
            "drawer_dividers": false
          },
          "blocks": {}
        }
      },
      "settings": {
        "logo_position": "left",
        "menu_position": "right",
        "menu_row": "top",
        "customer_account_menu": "customer-account-main-menu",
        "show_search": false,
        "search_position": "right",
        "search_row": "top",
        "show_country": false,
        "country_selector_style": false,
        "show_language": false,
        "localization_font": "body",
        "localization_font_size": "0.875rem",
        "localization_position": "right",
        "localization_row": "top",
        "section_width": "page-width",
        "section_height": "standard",
        "enable_sticky_header": "always",
        "divider_width": 0,
        "divider_size": "page-width",
        "divider_color": "{{ settings.color_palette.color2 }}",
        "border_width": 0,
        "bottom_border_color": "{{ settings.color_palette.color2 }}",
        "actions_display_style": "icon",
        "actions_font_size": "0.875rem",
        "actions_font": "body",
        "actions_text_case": "none",
        "background_color_top": "{{ settings.color_palette.background }}",
        "text_color_top": "{{ settings.color_palette.foreground }}",
        "background_color_bottom": "{{ settings.color_palette.background }}",
        "text_color_bottom": "{{ settings.color_palette.foreground }}",
        "bubble_style": "custom",
        "bubble_background_color": "{{ settings.color_palette.foreground }}",
        "bubble_text_color": "{{ settings.color_palette.background }}",
        "enable_transparent_header_home": true,
        "home_inverse_logo": false,
        "text_color_transparent_home": "{{ settings.color_palette.foreground }}",
        "enable_transparent_header_product": false,
        "product_inverse_logo": false,
        "enable_transparent_header_collection": false,
        "collection_inverse_logo": false
      }
    }
  },
  "order": [
    "header_announcements",
    "header_section"
  ]
}
